# Variables d'environnement de production — X-Pressing API
#
# À copier/coller dans Coolify (onglet « Environment Variables » de la
# ressource). Ce fichier ne contient AUCUN secret réel : il documente les
# clés attendues et leurs valeurs de production.
#
# Pour un `docker compose up -d` manuel sur le VPS, copier ce fichier en
# `.env` à côté de docker-compose.yml et remplir les valeurs.

# --- Application ----------------------------------------------------------
APP_NAME=X-Pressing
APP_ENV=production
# Générer UNE SEULE FOIS, puis ne plus jamais changer : la clé chiffre les
# données stockées, la modifier les rend illisibles.
#   docker run --rm php:8.2-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# (ou `php artisan key:generate --show` si PHP est installé en local)
APP_KEY=
APP_DEBUG=false
# Domaine public de l'API, tel que configuré dans Coolify, en https://
APP_URL=https://api.exemple.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# --- Logs -----------------------------------------------------------------
# stderr -> les logs remontent dans Docker, donc dans l'onglet Logs de
# Coolify, plutôt que dans un fichier du conteneur que personne ne lira.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

# --- Base de données ------------------------------------------------------
DB_CONNECTION=mysql
# Avec docker-compose.yml : `mysql` (nom du service).
# Avec une base gérée par Coolify : le hostname interne affiché par Coolify.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=xpressing
DB_USERNAME=xpressing
DB_PASSWORD=
# Uniquement utilisé par le service mysql du docker-compose.yml.
DB_ROOT_PASSWORD=

# Base MySQL distante exigeant TLS (Aiven & co.) : chemin du certificat CA
# dans le conteneur. Le dépôt embarque celui d'Aiven.
# MYSQL_ATTR_SSL_CA=/var/www/html/storage/certs/aiven-ca.pem

# --- Sessions / cache / files ---------------------------------------------
SESSION_DRIVER=database
CACHE_STORE=database
# `sync` exécute les notifications dans la requête HTTP. Passer à `database`
# uniquement si le service `queue` du docker-compose.yml est démarré.
QUEUE_CONNECTION=sync

# --- CORS (frontend React) ------------------------------------------------
FRONTEND_URL=https://x-pressing.exemple.com
# Liste séparée par des virgules : toutes les origines autorisées à appeler
# l'API. Aucune valeur en trop — c'est ce qui protège l'API côté navigateur.
FRONTEND_URLS=https://x-pressing.exemple.com

# --- Mail -----------------------------------------------------------------
# `log` tant qu'aucun fournisseur SMTP n'est configuré : aucun envoi réel.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@x-pressing.example
MAIL_FROM_NAME=X-Pressing

# --- Paiements ------------------------------------------------------------
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_SANDBOX=true

# --- Comportement au démarrage du conteneur (docker/entrypoint.sh) --------
# Migrations jouées à chaque déploiement. Mettre `false` pour figer le schéma.
RUN_MIGRATIONS=true
# Passer à `true` le temps d'UN redémarrage pour créer le jeu de démo, puis
# remettre `false` : le seeder écrase des données existantes.
SEED_DEMO_DATA=false
# Proxies de confiance. `*` convient derrière le proxy de Coolify, seul
# capable d'atteindre le conteneur sur le réseau Docker interne.
TRUSTED_PROXIES=*
